{% extends "assets/template.twig" %}
{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
			<div class="card-header">
				<ul class="nav nav-pills">
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/navigation.php"><i class="fas fa-arrow-left"></i> Back to Settings</span></a></li>
					{% if "PROJECTS:PROJECT_TYPES:VIEW"|instancePermissions %}
                    <li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/projectTypes.php">Project Types</a></li>
                    {% endif %}
					{% if "PROJECTS:PROJECT_STATUSES:VIEW"|instancePermissions %}
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/projectStatuses.php">Project Statuses</a></li>
                    {% endif %}
					{% if "BUSINESS:BUSINESS_SETTINGS:VIEW"|instancePermissions %}
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/configuration/asset-status.php">Asset Statuses</a></li>
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/configuration/invoices.php">Invoices</a></li>
                    {% endif %}
					<li class="nav-item"><a class="nav-link active" href="{{CONFIG.ROOTURL}}/instances/configuration/projectFinanceExport.php">Project Finance Export</a></li>
				</ul>
			</div>
		</div>
    </div>
</div>
<div class="row">
    <div class="col-12 col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Project Finance Export</h3>
            </div>
            <form action="{{CONFIG.ROOTURL}}/api/projects/exportFinance.php" method="GET" target="_blank">
                <div class="card-body">
                    <p>Export projects delivered between two dates as a CSV. Use it either as a project-by-project stats/outstanding-balance sheet, or - with equipment line detail switched on - to work out what's owed to each equipment-owning entity for the projects that used their kit.</p>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="start">Delivery start (from)</label>
                            <input type="date" class="form-control" id="start" name="start" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label for="end">Delivery start (to)</label>
                            <input type="date" class="form-control" id="end" name="end" required>
                        </div>
                    </div>
                    <div class="form-group form-check">
                        <input type="checkbox" class="form-check-input" id="archived" name="archived" value="1">
                        <label class="form-check-label" for="archived">Include archived projects</label>
                    </div>
                    <div class="form-group form-check">
                        <input type="checkbox" class="form-check-input" id="lines" name="lines" value="1">
                        <label class="form-check-label" for="lines">Include equipment line detail (asset-by-asset, with entity payout columns)</label>
                    </div>
                    <div class="form-group">
                        <label for="ownerShare">Owner share % (used for the entity payout columns)</label>
                        <input type="number" class="form-control" style="max-width: 150px;" id="ownerShare" name="ownerShare" value="60" min="0" max="100" step="0.1">
                    </div>
                    {% if projectStatuses|length > 0 %}
                    <div class="form-group">
                        <label>Filter by project status <small>(leave all unchecked to include every status)</small></label><br>
                        {% for status in projectStatuses %}
                        <div class="form-check form-check-inline">
                            <input type="checkbox" class="form-check-input" id="status{{ status.projectsStatuses_id }}" name="statuses[]" value="{{ status.projectsStatuses_id }}">
                            <label class="form-check-label" for="status{{ status.projectsStatuses_id }}">{{ status.projectsStatuses_name }}</label>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-default">Download CSV</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
