<!doctype html>
<html lang='en'>
<head>
    <meta charset='utf-8'>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.6/pdfmake.min.js" integrity="sha512-7BzHjLXs8xehClrkJEtJtAwXxcbLast87k+XekuItHxrMr/v6POWkoKS2/8CU6DHdIjY+A4NwvsBQ8PxoRH7xQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.6/vfs_fonts.min.js" integrity="sha512-P0bOMePRS378NwmPDVPU455C/TuxDS+8QwJozdc7PGgN8kLqR4ems0U/3DeJkmiE31749vYWHvBOtR+37qDCZQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        var docDefinition = {
            content: [
                {
                    columns: [
                        {
                            stack: [
                                {% if INSTANCELOGO %}
                                    {
                                        image: "{{ INSTANCELOGO|escape("js") }}",
                                        fit: [141.73, 62.36]
                                    },
                                {% endif %}
                                {% if GET['addresses'] %}
                                    { text: " ", fontSize: 4 },
                                    { text: "{{ USERDATA.instance.instances_website|escape("js") }}", fontSize: 7, color: '#595959', link: "{{ USERDATA.instance.instances_website|escape("js") }}" },
                                    { text: "email: {{ USERDATA.instance.instances_email|escape("js") }}", fontSize: 7, color: '#595959' },
                                    { text: "phone: {{ USERDATA.instance.instances_phone|escape("js") }}", fontSize: 7, color: '#595959' },
                                {% endif %}
                            ],
                            width: 'auto'
                        },
                        {
                            stack: [
                                { text: "{{ USERDATA['instance']['instances_name']|escape("js") }}", bold: true, fontSize: 10, color: '#595959' },
                                {% if GET['addresses'] %}
                                    { text: "{{ USERDATA.instance.instances_address|escape("js") }}", fontSize: 9, color: '#595959' },
                                {% endif %}
                            ],
                            alignment: "right",
                            width: "*",
                            margin: [0, 12, 0, 0]
                        }
                    ],
                    margin: [0, 0, 0, 20]
                },
                {
                    columns: [
                        {
                            width: 226.77,
                            stack: [
                                { text: "{{ project.projects_name|escape("js") }}", bold: true, fontSize: 16 },
                                { text: "{{ GET['fileType']}}{% if fileNumber %} V{{ fileNumber|escape("js") }}{% endif %}", fontSize: 14 },
                                { text: "{{ 'now'|date('j M Y') }}", color: '#595959' },
                            ]
                        }
                    ],
                    margin: [0, 10, 0, 10]
                },
                {% if project.projectsTypes_config_client == 1 %}
                {
                    columns: [
                        {
                            width: 184.25,
                            stack: [
                                { text: "{{ project.clients_name|escape("js") }}", bold: true },
                                {% if GET['addresses'] %}
                                    "{{ project.clients_address|escape("js") }}",
                                    " ",
                                    "{{ project.clients_website|escape("js") }}",
                                    "{{ project.clients_email|escape("js") }}",
                                    "{{ project.clients_phone|escape("js") }}"
                                {% endif %}
                            ]
                        }
                    ],
                    absolutePosition: { x: 354.33, y: 127.56 }
                },
                {% endif %}
                " ",
                {% if FINANCIALS.priceMaths['days'] > 0 %}
                    {% set coeffVal = FINANCIALS.priceMaths['days'] %}
                    {% set coeffSuffix = 'd' %}
                {% else %}
                    {% set coeffVal = FINANCIALS.priceMaths['weeks'] %}
                    {% set coeffSuffix = 'w' %}
                {% endif %}
                {% set coeffFmt = coeffVal|number_format(2, '.', '') %}
                {% if coeffFmt ends with '.00' %}
                    {% set coeffDisplay = coeffVal|number_format(0, '.', '') ~ coeffSuffix %}
                {% elseif coeffFmt ends with '0' %}
                    {% set coeffDisplay = coeffVal|number_format(1, '.', '') ~ coeffSuffix %}
                {% else %}
                    {% set coeffDisplay = coeffFmt ~ coeffSuffix %}
                {% endif %}
                {
                    table: {
                        widths: [ "50%", "50%"],
                        body: [[
                            {
                                table: {
                                    widths: [ 110, '*' ],
                                    body: [
                                        [{ text: 'Our Reference:', bold: true },"{{project.projects_id|escape("js")}}"],
                                        {% if GET['pmdetails'] %}
                                            [{ text: 'Contact:', bold: true },"{{ project.users_name1|escape("js") ~ " " ~ project.users_name2|escape("js") ~ " " ~ project.users_email|escape("js") }}"],
                                        {% endif %}
                                        {% if project.projects_dates_use_start or project.projects_dates_use_end %}
                                            [{ text: 'Project Date:', bold: true },{ text: "{% if project.projects_dates_use_start %}{{ project.projects_dates_use_start|date("j M Y")|escape("js") }}{% endif %}{% if project.projects_dates_use_start and project.projects_dates_use_end %} - {% endif %}{% if project.projects_dates_use_end %}{{ project.projects_dates_use_end|date("j M Y")|escape("js") }}{% endif %}", noWrap: true }],
                                        {% endif %}
                                        [{ text: 'Coeff:', bold: true },{ text: "{{ coeffDisplay|escape("js") }}", bold: true }],
                                        {% if project.projects_dates_deliver_start or project.projects_dates_deliver_end %}
                                            [{ text: 'Pick-up / Drop-off:', bold: true },{ text: "{% if project.projects_dates_deliver_start %}{{ project.projects_dates_deliver_start|date("j M Y")|escape("js") }}{% endif %}{% if project.projects_dates_deliver_start and project.projects_dates_deliver_end %} - {% endif %}{% if project.projects_dates_deliver_end %}{{ project.projects_dates_deliver_end|date("j M Y")|escape("js") }}{% endif %}", noWrap: true }],
                                        {% endif %}
                                        {% if GET['totalmass'] and project.projectsTypes_config_assets == 1 %}
                                            [{ text: 'Mass Estimate:', bold: true },"{{FINANCIALS.mass|mass|escape("js") }}"],
                                        {% endif %}
                                        {% if GET['totalvalue'] and project.projectsTypes_config_assets == 1 %}
                                            [{ text: 'Value Estimate:', bold: true },"{{FINANCIALS.value|money|escape("js") }}"],
                                        {% endif %}
                                    ],
                                },
                                layout: 'noBorders',
                                margin: 10
                            },
                            {% if GET['venue'] and project.projectsTypes_config_venue == 1 %}
                            {
                                stack: [
                                    { text: 'Venue', style: {bold: true}},
                                    "{{ project.locations_name|escape("js") }}",
                                    "{{ project.locations_address|escape("js") }}"
                                ],
                                style: { alignment: "right" },
                                margin: 10
                            },
                            {% endif %}
                        ]],
                    },
                    fillColor: '#F5F5F5',
                    layout: 'noBorders',
                    margin: [ 0, 10, 0, 10 ]
                },
                {% set columnCount = 2 %}
                {% if GET['checkboxes'] %}{% set columnCount = columnCount + 1 %}{% endif %}
                {% if GET['masses'] %}{% set columnCount = columnCount + 1 %}{% endif %}
                {% if project.projectsTypes_config_finance == 1 %}{% set columnCount = columnCount + 5 %}{% endif %}

                {#
                    pdfmake treats widths as CONTENT widths; padding is added on top.
                    Custom layout below uses 2pt each side = 4pt overhead per column.
                    Total rendered = sum(widths) + columnCount * 4
                    To fit 495pt: sum(widths) = 495 - columnCount * 4
                    Each fixed width = desired_visual_width - 4.
                    Target visuals: cb=20, id=30, mass=31, base=62, coeff=29, calc=62, disc=26, final=62
                #}
                {% set itemW = 495 - columnCount * 4 %}
                {% if GET['checkboxes'] %}{% set itemW = itemW - 16 %}{% endif %}
                {% set itemW = itemW - 30 %}
                {% if GET['masses'] %}{% set itemW = itemW - 27 %}{% endif %}
                {% if project.projectsTypes_config_finance == 1 %}{% set itemW = itemW - 173 %}{% endif %}

                {% if GET['assets'] and project.projectsTypes_config_assets == 1 %}
                    {% set allAssets = FINANCIALS.assetsAssigned %}
                    {% for instance in FINANCIALS.assetsAssignedSUB %}
                        {% set allAssets = allAssets|merge(instance['assets']) %}
                    {% endfor %}
                    {% set allAssets = allAssets|sort((a, b) => a['assets'][0].assetCategories_name <=> b['assets'][0].assetCategories_name) %}

                    {# Build linkedMap (parent assetsAssignments_id → children) and strip
                       children from their own type groups — they render below their parent. #}
                    {% set linkedMap = {} %}
                    {% set filteredAssets = [] %}
                    {% for type in allAssets %}
                        {% set mainOnly = [] %}
                        {% for asset in type['assets'] %}
                            {% if asset.assetsAssignments_linkedTo %}
                                {% set pid = 'k' ~ asset.assetsAssignments_linkedTo %}
                                {% set existing = linkedMap[pid] is defined ? linkedMap[pid] : [] %}
                                {% set linkedMap = linkedMap|merge({(pid): existing|merge([asset])}) %}
                            {% else %}
                                {% set mainOnly = mainOnly|merge([asset]) %}
                            {% endif %}
                        {% endfor %}
                        {% if mainOnly|length > 0 %}
                            {% set filteredAssets = filteredAssets|merge([type|merge({'assets': mainOnly})]) %}
                        {% endif %}
                    {% endfor %}

                    {% if filteredAssets|length > 0 %}
                        {
                            table: {
                                headerRows: 1,
                                widths: [
                                    {% if GET['checkboxes'] %}16,{% endif %}
                                    30,
                                    {{ itemW }},
                                    {% if GET['masses'] %}27,{% endif %}
                                    {% if project.projectsTypes_config_finance == 1 %}
                                        42, 25, 42, 25, 42,
                                    {% endif %}
                                ],
                                body: [
                                    [
                                        {% if GET['checkboxes'] %}{ text: '' },{% endif %}
                                        { text: 'ID', style: { bold: true } },
                                        { text: 'Item', style: { bold: true } },
                                        {% if GET['masses'] %}{ stack: [{ text: 'Mass', bold: true }, { text: 'kg' }], alignment: 'right' },{% endif %}
                                        {% if project.projectsTypes_config_finance == 1 %}
                                            { stack: [{ text: 'Base', bold: true }, { text: '{{ moneySymbol() }}' }], alignment: 'right' },
                                            { text: 'Coeff', style: { bold: true, alignment: 'right' } },
                                            { stack: [{ text: 'Calc', bold: true }, { text: '{{ moneySymbol() }}' }], alignment: 'right' },
                                            { text: 'Disc', style: { bold: true, alignment: 'right' } },
                                            { stack: [{ text: 'Final', bold: true }, { text: '{{ moneySymbol() }}' }], alignment: 'right' },
                                        {% endif %}
                                    ],
                                {% set currentCategory = "" %}
                                {% for type in filteredAssets %}
                                    {% if type['assets'][0].assetCategories_name != currentCategory %}
                                        {% set currentCategory = type['assets'][0].assetCategories_name %}
                                        {% set currentCategoryID = type['assets'][0].assetCategories_id %}
                                        [{
                                            text: "{{ type['assets'][0].assetCategoriesGroups_name|escape("js") }} / {{ type['assets'][0].assetCategories_name|escape("js") }}",
                                            style: { bold: true },
                                            fillColor: '#F5F5F5',
                                            colSpan: {{ columnCount }},
                                            margin: 3
                                        },
                                        {% for i in range(2, columnCount) %}{},{% endfor %}
                                    ],
                                    {% endif %}
                                    {% embed 'project/twigIncludes/assetList/tableItemPDF.twig' with {"type": type, "all": filteredAssets, "categoryid": currentCategoryID, "instanceid": USERDATA.instance.instances_id, "linkedMap": linkedMap} %}{% endembed %}
                                {% endfor %}
                                ],
                            },
                            layout: {
                                hLineWidth: function(i, node) {
                                    if (i === 0 || i === node.table.body.length) return 0;
                                    if (i === 1) return 1;
                                    return 0.5;
                                },
                                vLineWidth: function() { return 0; },
                                hLineColor: function(i) { return i === 1 ? 'black' : '#aaaaaa'; },
                                paddingLeft: function() { return 2; },
                                paddingRight: function() { return 2; },
                                paddingTop: function() { return 2; },
                                paddingBottom: function() { return 2; }
                            },
                            margin: [ 0, 10, 0, 10 ]
                        },
                    {% endif %}
                    { text: "{{ allAssets|length }} Total Item{{ allAssets|length != 1 ? 's' }}", style: { fontSize: 9, bold: true, alignment: 'right' } },
                {% endif %}
                {% set showSubHires = FINANCIALS.payments.subHire.ledger|length > 0 and project.projectsTypes_config_finance == 1 and GET['subHires'] %}
                {% set showSales = FINANCIALS.payments.sales.ledger|length > 0 and project.projectsTypes_config_finance == 1 and GET['sales'] %}
                {% set showStaff = FINANCIALS.payments.staff.ledger|length > 0 and project.projectsTypes_config_finance == 1 and GET['staff'] %}
                {% if showSubHires or showSales or showStaff %}
                    {
                        table: {
                            headerRows: 1,
                            widths: [
                                {% if GET['checkboxes'] %}16,{% endif %}
                                30,
                                {{ itemW }},
                                {% if GET['masses'] %}27,{% endif %}
                                {% if project.projectsTypes_config_finance == 1 %}
                                    42, 25, 42, 25, 42,
                                {% endif %}
                            ],
                            body: [
                                [
                                    {% if GET['checkboxes'] %}{ text: '' },{% endif %}
                                    { text: '' },
                                    { text: 'Item', style: { bold: true } },
                                    {% if GET['masses'] %}{ text: '' },{% endif %}
                                    {% if project.projectsTypes_config_finance == 1 %}
                                        { stack: [{ text: 'Base', bold: true }, { text: '{{ moneySymbol() }}' }], alignment: 'right' },
                                        { text: 'Qty', style: { bold: true, alignment: 'right' } },
                                        { text: '' },
                                        { text: '' },
                                        { stack: [{ text: 'Final', bold: true }, { text: '{{ moneySymbol() }}' }], alignment: 'right' },
                                    {% endif %}
                                ],
                                {% for group in [
                                    { show: showSubHires, label: "Additional Hire Items", ledger: FINANCIALS.payments.subHire.ledger },
                                    { show: showSales, label: "Sales", ledger: FINANCIALS.payments.sales.ledger },
                                    { show: showStaff, label: "Staff", ledger: FINANCIALS.payments.staff.ledger }
                                ] %}
                                    {% if group.show %}
                                        [{
                                            text: "{{ group.label|escape("js") }}",
                                            style: { bold: true },
                                            fillColor: '#F5F5F5',
                                            colSpan: {{ columnCount }},
                                            margin: 3
                                        },
                                        {% for i in range(2, columnCount) %}{},{% endfor %}
                                        ],
                                        {% for payment in group.ledger %}
                                        [
                                            {% if GET['checkboxes'] %}{ text: '' },{% endif %}
                                            { text: '' },
                                            {
                                                stack: [
                                                    { text: "{{ payment.payments_supplier|escape("js") }}" },
                                                    { text: "{{ payment.payments_comment|escape("js") }}", color: '#595959', margin: [0, 2, 0, 0] }
                                                ]
                                            },
                                            {% if GET['masses'] %}{ text: '' },{% endif %}
                                            {% if project.projectsTypes_config_finance == 1 %}
                                                { text: "{% if GET['prices'] %}{{ payment.payments_amount|moneyDecimal|escape("js") }}{% endif %}", style: { alignment: 'right' } },
                                                { text: "{{ payment.payments_quantity|escape("js") }}", style: { alignment: 'right' } },
                                                { text: '' },
                                                { text: '' },
                                                { text: "{% if GET['prices'] %}{{ payment.payments_amountTotal|moneyDecimal|escape("js") }}{% endif %}", style: { alignment: 'right' } },
                                            {% endif %}
                                        ],
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            ],
                        },
                        layout: {
                            hLineWidth: function(i, node) {
                                if (i === 0 || i === node.table.body.length) return 0;
                                if (i === 1) return 1;
                                return 0.5;
                            },
                            vLineWidth: function() { return 0; },
                            hLineColor: function(i) { return i === 1 ? 'black' : '#aaaaaa'; },
                            paddingLeft: function() { return 2; },
                            paddingRight: function() { return 2; },
                            paddingTop: function() { return 2; },
                            paddingBottom: function() { return 2; }
                        },
                        margin: [ 0, 10, 0, 10 ]
                    },
                {% endif %}
                {% if GET['assets'] and project.projectsTypes_config_assets == 1 %}
                    {% if GET['flagsBlocks'] %}{ text: "[F] indicates asset flagged, [B] indicates asset blocked" },{% endif %}
                    { text: "[L] indicates asset linked to another" },
                    { text: " " },
                    { text: " " },
                {% endif %}
                {% if GET['finance'] and "PROJECTS:PROJECT_PAYMENTS:VIEW"|instancePermissions and project.projectsTypes_config_finance == 1 %}
                {
                    table: {
                        widths: [ "35%", "15%", "35%", "15%"],
                        body: [
                            [
                                { text: "{% if GET['sales'] %}Sales{% endif %}" },
                                { text: "{% if GET['sales'] %}{{ FINANCIALS.payments.sales.total|money|escape("js") }}{% endif %}", style: { alignment: 'right' } },
                                { text: "Equipment SubTotal" },
                                { text: "{{ FINANCIALS.prices.subTotal|money|escape("js") }}", style: { alignment: 'right' } },
                            ],
                            [
                                { text: "{% if GET['staff'] %}Staffing{% endif %}" },
                                { text: "{% if GET['staff'] %}{{ FINANCIALS.payments.staff.total|money|escape("js") }}{% endif %}", style: { alignment: 'right' } },
                                { text: "{% if FINANCIALS.prices.discounts|moneyPositive %}Discounts{% else %}Adjustments{% endif %}" },
                                { text: "{% if FINANCIALS.prices.discounts|moneyPositive %}-{{ FINANCIALS.prices.discounts|money|escape("js") }}{% else %}None{% endif %}", style: { alignment: 'right' } },
                            ],
                            [
                                { text: "{% if GET['subHires'] %}Sub Hires{% endif %}" },
                                { text: "{% if GET['subHires'] %}{{ FINANCIALS.payments.subHire.total|money|escape("js") }}{% endif %}", style: { alignment: 'right' } },
                                { text: "Equipment Total", style: { bold: true } },
                                { text: "{{ FINANCIALS.prices.total|money|escape("js") }}", style: { alignment: 'right' } },
                            ],
                            {% if GET['insurance'] %}
                            [
                                { text: "" },
                                { text: "" },
                                { text: "Insurance" },
                                { text: "{{ FINANCIALS.insurance.total|money|escape("js") }}", style: { alignment: 'right' } },
                            ],
                            {% endif %}
                            {% if GET['type'] == "invoice" %}
                            [
                                { text: "" },
                                { text: "" },
                                { text: "SubTotal", style: { bold: true } },
                                { text: "{{ FINANCIALS.payments.subTotal|money|escape("js") }}", style: { alignment: 'right' } },
                            ],
                            {% endif %}
                            {% if GET['vat'] %}
                            [
                                { text: "" },
                                { text: "" },
                                { text: "VAT{% if FINANCIALS.vat.isExport %} (Export){% endif %}" },
                                { text: "{{ FINANCIALS.vat.total|money|escape("js") }}", style: { alignment: 'right' } },
                            ],
                            {% endif %}
                            {% if GET['type'] == "invoice" %}
                            [
                                { text: "" },
                                { text: "" },
                                { text: "Payments Received to Date" },
                                { text: "-{{ FINANCIALS.payments.received.total|money|escape("js") }}", style: { alignment: 'right' } },
                            ],
                            {% endif %}
                            [
                                { text: "" },
                                { text: "" },
                                { text: "{% if GET['type'] == 'quote' %}Grand Total{% else %}Grand Total Outstanding{% endif %}", style: { bold: true } },
                                { text: "{{ FINANCIALS.payments.total|money|escape("js") }}", style: { alignment: 'right' } },
                            ],
                        ],
                    },
                    layout: 'noBorders',
                },
                {% endif %}
                {% if project.projects_invoiceNotes|length > 0 and GET['invoiceNotes'] and GET['type'] != 'deliveryNote' %}
                    { text: "Notes", style: { fontSize: 14, bold: true } },
                    "{{ project.projects_invoiceNotes|escape("js") }}",
                {% endif %}
                {% if project.projects_deliveryNotes|length > 0 and GET['type'] == 'deliveryNote' %}
                    { text: "Delivery Notes", style: { fontSize: 14, bold: true }, margin: [ 0, 20, 0, 0 ] },
                    "{{ project.projects_deliveryNotes|escape("js") }}",
                {% endif %}
                {% if GET['paymentTerms'] %}
                {
                    table: {
                        widths: [ "100%"],
                        body: [[
                            { text: "{% if GET['type'] == 'quote' %}{{ USERDATA.instance.instances_quoteTerms|striptags|escape("js") }}{% elseif GET['type'] == 'deliveryNote' %}{{ USERDATA.instance.instances_deliveryNoteTerms|replace({"</p>":"\n", "<br/>":"\n"})|striptags|escape("js") }}{% else %}{{ USERDATA.instance.instances_termsAndPayment|replace({"</p>":"\n", "<br/>":"\n"})|striptags|escape("js") }}{% endif %}", margin: 5 }
                        ]],
                    },
                    fillColor: '#F5F5F5',
                    layout: 'noBorders',
                    margin: [ 0, 15, 0, 0 ]
                },
                {% endif %}
                {% if QRBILL_IMAGE %}
                { text: '', pageBreak: 'before' },
                {
                    canvas: [
                        { type: 'line', x1: 0, y1: 544.25, x2: 595.28, y2: 544.25, lineWidth: 0.75, dash: { length: 2 } },
                        { type: 'line', x1: 175.75, y1: 544.25, x2: 175.75, y2: 841.89, lineWidth: 0.75, dash: { length: 2 } }
                    ],
                    absolutePosition: { x: 0, y: 0 }
                },
                { text: 'Receipt', bold: true, fontSize: 11, absolutePosition: { x: 14.17, y: 555 } },
                { text: 'Account / Payable to', fontSize: 6, bold: true, absolutePosition: { x: 14.17, y: 585 } },
                { columns: [{ text: "{{ QRBILL_TEXT.iban|escape("js") }}\n{{ QRBILL_TEXT.creditor|escape("js") }}", fontSize: 8, width: 155 }], absolutePosition: { x: 14.17, y: 593 } },
                { text: 'Reference', fontSize: 6, bold: true, absolutePosition: { x: 14.17, y: 645 } },
                { columns: [{ text: "{{ QRBILL_TEXT.reference|escape("js") }}", fontSize: 8, width: 155 }], absolutePosition: { x: 14.17, y: 653 } },
                {% if QRBILL_TEXT.debtor %}
                { text: 'Payable by', fontSize: 6, bold: true, absolutePosition: { x: 14.17, y: 690 } },
                { columns: [{ text: "{{ QRBILL_TEXT.debtor|escape("js") }}", fontSize: 8, width: 155 }], absolutePosition: { x: 14.17, y: 698 } },
                {% endif %}
                { text: 'Currency', fontSize: 6, bold: true, absolutePosition: { x: 14.17, y: 750 } },
                { text: 'Amount', fontSize: 6, bold: true, absolutePosition: { x: 65, y: 750 } },
                { text: "{{ QRBILL_TEXT.currency|escape("js") }}", fontSize: 8, absolutePosition: { x: 14.17, y: 758 } },
                { text: "{{ QRBILL_TEXT.amount|escape("js") }}", fontSize: 8, absolutePosition: { x: 65, y: 758 } },
                { columns: [{ text: 'Acceptance point', fontSize: 6, alignment: 'right', width: 155 }], absolutePosition: { x: 14.17, y: 778 } },
                { text: 'Payment part', bold: true, fontSize: 11, absolutePosition: { x: 190, y: 555 } },
                { svg: "{{ QRBILL_IMAGE|escape("js") }}", absolutePosition: { x: 190, y: 580 }, width: 130.4 },
                { text: 'Currency', fontSize: 6, bold: true, absolutePosition: { x: 190, y: 720 } },
                { text: 'Amount', fontSize: 6, bold: true, absolutePosition: { x: 241, y: 720 } },
                { text: "{{ QRBILL_TEXT.currency|escape("js") }}", fontSize: 8, absolutePosition: { x: 190, y: 728 } },
                { text: "{{ QRBILL_TEXT.amount|escape("js") }}", fontSize: 8, absolutePosition: { x: 241, y: 728 } },
                { text: 'Account / Payable to', fontSize: 6, bold: true, absolutePosition: { x: 340, y: 555 } },
                { columns: [{ text: "{{ QRBILL_TEXT.iban|escape("js") }}\n{{ QRBILL_TEXT.creditor|escape("js") }}", fontSize: 8, width: 195 }], absolutePosition: { x: 340, y: 563 } },
                { text: 'Reference', fontSize: 6, bold: true, absolutePosition: { x: 340, y: 615 } },
                { columns: [{ text: "{{ QRBILL_TEXT.reference|escape("js") }}", fontSize: 8, width: 195 }], absolutePosition: { x: 340, y: 623 } },
                {% set paymentPartPayableByY = 660 %}
                {% if QRBILL_TEXT.additionalInfo %}
                { text: 'Additional information', fontSize: 6, bold: true, absolutePosition: { x: 340, y: 645 } },
                { columns: [{ text: "{{ QRBILL_TEXT.additionalInfo|escape("js") }}", fontSize: 8, width: 195 }], absolutePosition: { x: 340, y: 653 } },
                {% set paymentPartPayableByY = 700 %}
                {% endif %}
                {% if QRBILL_TEXT.debtor %}
                { text: 'Payable by', fontSize: 6, bold: true, absolutePosition: { x: 340, y: {{ paymentPartPayableByY }} } },
                { columns: [{ text: "{{ QRBILL_TEXT.debtor|escape("js") }}", fontSize: 8, width: 195 }], absolutePosition: { x: 340, y: {{ paymentPartPayableByY + 8 }} } },
                {% endif %}
                {% endif %}
            ],
            header: function(currentPage, pageCount) {
                if (currentPage === 1) return null;
                {% if QRBILL_IMAGE %}if (currentPage === pageCount) return null;{% endif %}
                return {
                    columns: [
                        {text: "{{ USERDATA['instance']['instances_name']|escape("js") }}", width: "40%"},
                        {text: "{{ GET['fileType']}}", alignment: 'center', width: "20%"},
                        { text: "{% if project.projectsTypes_config_client == 1 and project['clients_name'] %}{{  project['clients_name']|escape("js") }} - {% endif %}{{ project['projects_name']|escape("js") }}", alignment: 'right', width: "40%"}
                    ]
                    , margin: [40, 20, 40, 20]
                };
            },
            footer: function(currentPage, pageCount) {
                if (currentPage === 1) return null;
                {% if QRBILL_IMAGE %}if (currentPage === pageCount) return null;{% endif %}
                return {
                    columns: [
                        {text: "{{ "now"|date("j M Y h:i:sa")|escape("js") }}", width: "50%"},
                        {text: currentPage.toString() + '/' + pageCount, alignment: 'right', width: "50%"}]
                    , margin: [40, 20, 40, 20]
                };
            },
            {% if GET['draft'] %}watermark: { text: 'DRAFT', opacity: 0.2, bold: true, italics: false },{% endif %}
            defaultStyle: { fontSize: 9 },
            pageSize: 'A4',
            pageOrientation: 'portrait',
            pageMargins: [ 56.69, 51.02, 56.69, 51.02 ],
            info: {
                title: "{% if project.projectsTypes_config_client == 1 and project['clients_name'] %}{{  project['clients_name']|escape("js") }} - {% endif %}{{ project['projects_name']|escape("js") }}",
                author: "{{ USERDATA['instance']['instances_name']|escape("js") }}",
                subject: "{{ project['projects_name']|escape("js") }}",
                keywords: 'AdamRMS',
            },
            compress: true,
        };
        try {
            var pdf = pdfMake.createPdf(docDefinition);
            {% if GET['draft'] or CONFIG.FILES_ENABLED != "Enabled" or USERDATA.instance.instances_storageEnabled != 1 %}
            pdf.download("{{ "now"|date("y-m-d") }}_{% if project.clients_name %}{{ project.clients_name|replace({' ':'-'})|escape("js") }}_{% endif %}{{ project.projects_name|replace({' ':'-'})|escape("js") }}_{{ GET['fileType'] }}_draft.pdf", function() {
                // Firefox takes a bit longer to do file actions, so delay closing this tab a little
                setTimeout(() => {window.close()}, 100)
            });
            {% else %}
            pdf.getBlob((blob) => {
                var formData = new FormData();
                formData.append("file", blob, {type: "application/pdf"});
                formData.append("type","{{ GET['type'] }}");
                formData.append("fileNumber", "{{ fileNumber|escape("js") }}");
                formData.append("id", "{{ project['projects_id'] }}");
                var oReq = new XMLHttpRequest();
                oReq.open("POST", "{{CONFIG.ROOTURL}}/api/s3files/uploadProjectInvoice.php", true);
                oReq.onload = function (oEvent) {
                    var response = JSON.parse(oReq.responseText);
                    console.log(response)
                    if (response.error && response.error.code && response.error.code == "AUTH") {
                        //They need to login again - token probably expired
                        location.reload();
                    } else if (response.error && response.error.code) {
                        alert(response.error.message);
                    } else if (response.result && response.response && response.response.url) {
                        pdf.download("{{ "now"|date("y-m-d") }}_{% if project.clients_name %}{{ project.clients_name|replace({' ':'-'})|escape("js") }}_{% endif %}{{ project.projects_name|replace({' ':'-'})|escape("js") }}_{{ GET['fileType'] }}_v{{ fileNumber|escape("js") }}.pdf", function() {
                            // Firefox takes a bit longer to do file actions, so delay closing this tab a little
                            setTimeout(() => {window.close()}, 100)
                        });
                    } else {
                        alert("Error loading PDF");
                    }
                };
                oReq.onerror = function(error) {
                    alert("Error creating invoice");
                }
                oReq.send(formData);
            });
            {% endif %}
        } catch(err) {
            alert(err.message);
        }
    </script>
</head>
<body>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pace/1.0.2/pace.min.js" integrity="sha256-EPrkNjGEmCWyazb3A/Epj+W7Qm2pB9vnfXw+X6LImPM=" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="{{ CONFIG.ROOTURL }}/static-assets/libs/pace/pace.css">
    <!--Pace Loader-->
    <script>
        window.paceOptions = {
            startOnPageLoad: false,
            document: false,
            eventLag: false,
            ajax: false,
        };
        Pace.start();
    </script>
    Generating PDF, please wait...
</body>
</html>