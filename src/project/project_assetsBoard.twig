<!--Sortable-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js" integrity="sha256-KM512VNnjElC30ehFwehXjx1YCHPiQkOPmqnrWtpccM=" crossorigin="anonymous"></script>
<!-- Resolve conflict in jQuery UI tooltip with Bootstrap tooltip -->
<script>
    $.widget.bridge('uibutton', $.ui.button)
</script>
<style>
    .scrolling-head {
        display: flex;
        flex-wrap: wrap;
    }
    @media only screen and (max-width: 768px) {
        .scrolling-head {
            display: block;
        }
        .scrolling-head > div {
            width: 100%;
            max-width: 100%;
        }
    }
    #navItemQuickDispatch {
        height: 100%;
    }
    #navItemQuickDispatch button {
        background-color: transparent;
    }
</style>
<style>
    #quickDispatchPanel {
        position: fixed;
        bottom: 16px;
        right: 16px;
        width: 340px;
        max-width: calc(100vw - 32px);
        z-index: 1040;
        box-shadow: 0 4px 16px rgba(0, 0, 0, .3);
    }
    #quickDispatchPanel .card-body { display: none; }
    #quickDispatchPanel.open .card-body { display: block; }
    .assetDispatchAssetList-card.flash { animation: assetDispatchFlash 2s ease-out; }
    @keyframes assetDispatchFlash { from { background-color: #ffc107; } to { background-color: transparent; } }
</style>
<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">Asset dispatch</h3>
        {% if FINANCIALS.assetsAssignedSUB|length > 0 %}
        <div class="card-tools form-inline">
            <select class="form-control form-control-sm" id="assetBoardEntityFilter">
                <option value="">All entities</option>
                <option value="{{ USERDATA.instance.instances_id }}">{{ USERDATA.instance.instances_name }}</option>
                {% for instance in FINANCIALS.assetsAssignedSUB %}
                    <option value="{{ instance['instance'].instances_id }}">{{ instance['instance'].instances_name }}</option>
                {% endfor %}
            </select>
        </div>
        {% endif %}
    </div>
    <div class="card-body p-0">
        {% include 'project/twigIncludes/assetBoard/board.twig' %}
    </div>
</div>
{% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions and BOARDSTATUSES|length > 0 %}
<div class="card card-primary open" id="quickDispatchPanel">
    <div class="card-header" style="cursor: pointer;" id="quickDispatchToggle">
        <h3 class="card-title"><i class="fas fa-shipping-fast"></i> Quick Dispatch</h3>
        <div class="card-tools"><i class="fas fa-chevron-down"></i></div>
    </div>
    <div class="card-body">
        <div class="form-group">
            <label>Set Asset Status to</label>
            <select class="form-control" id="assetStatusSelectorQuickDispatch">
                {% for status in BOARDSTATUSES %}
                <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="form-group">
            <label>Asset Tag</label>
            <div class="input-group">
                <input type="text" class="form-control" id="assetTagQuickDispatch" autocomplete="off" />
                <div class="input-group-append">
                    <button class="btn btn-outline-secondary" type="button" id="goQuickDispatch">
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
        <div id="assetTagResultQuickDispatch" style="max-height: 120px; overflow-y: auto;"></div>
    </div>
</div>
{% endif %}
<script>
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000
    });

    {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}

    // Ordered list of status ids for the project (the project's instance owns the status set)
    const orderedStatusIds = {{ BOARDSTATUSES|map(s => s['assetsAssignmentsStatus_id'])|json_encode|raw }}.map(Number);
    // Show/Hide relevant buttons for touchscreen control, and refresh the column counts
    function drawButtons() {
        $('.assetDispatchAssetList').each(function(){
            var statusid = parseInt($(this).data("statusid"));
            var position = orderedStatusIds.indexOf(statusid);
            var prev = (position <= 0 ? false : orderedStatusIds[position-1]);
            var next = (position == orderedStatusIds.length - 1 ? false : orderedStatusIds[position+1]);

            $(this).find(".assetDispatchAssetList-statusPrevButton").css('display', prev === false ? 'none': 'block');
            $(this).find(".assetDispatchAssetList-statusPrevButton").data('nextstatus', prev);
            $(this).find(".assetDispatchAssetList-statusNextButton").css('display', next === false ? 'none': 'block');
            $(this).find(".assetDispatchAssetList-statusNextButton").data('nextstatus', next);
            $(this).closest(".card").find(".assetDispatchColumnCount").text($(this).find(".assetDispatchAssetList-card").length);
        });
    }
    /**
     * Function to change the status of an asset assignment
     * @param assetsAssignments_id Id of the AssetAssignment
     * @param assetsAssignments_status new status id of the AssetAssignment
     */
    function changeStatus(assetsAssignments_id, assetsAssignments_status) {
        ajaxcall("projects/assets/setStatus.php", {"assetsAssignments_id":assetsAssignments_id, "assetsAssignments_status":assetsAssignments_status}, function (returned) {
            drawButtons();
            Toast.fire({
                type: 'success',
                title: 'Asset Status Updated'
            });
        });
    }
    /**
     * Move a card to a status column and flash it so the move is easy to see
     */
    function moveCard(assetCard, statusId, scrollTo) {
        assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + statusId + "]");
        assetCard.attr("data-currentstatus", statusId);
        drawButtons();
        assetCard.removeClass("flash");
        void assetCard[0].offsetWidth; // restart the animation
        assetCard.addClass("flash");
        if (scrollTo) assetCard[0].scrollIntoView({behavior: "smooth", block: "nearest", inline: "nearest"});
    }
    {% endif %}
    $(document).ready(function () {
        {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}
        drawButtons();
        $(".assetDispatchAssetList").sortable({
            connectWith: ".assetDispatchAssetList",
            update: function( event, ui ){
                /*
                Update function is called twice, once for the old list and once for the new list.
                The lists, this, have a data attribute, status, that can be compared with each asset, ui.item[0].
                If the groupStatus is the same as the old status, this call can be ignored as this is the old list update call.
                 */
                const groupStatus = this.dataset.statusid;
                const assetOldStatus = ui.item[0].dataset.currentstatus;
                const assetAssignment = ui.item[0].dataset.assignment;

                if (assetOldStatus !== groupStatus) {
                    changeStatus(parseInt(assetAssignment),parseInt(groupStatus));
                    ui.item[0].dataset.currentstatus = groupStatus;
                }
            }
        });

        $(".assetDispatchAssetList-statusPrevButton,.assetDispatchAssetList-statusNextButton").click(function (){
            const assetCard = $(this).parent();
            const assetAssignment = assetCard.data("assignment");
            const assetNextStatus = $(this).data("nextstatus");
            changeStatus(parseInt(assetAssignment),parseInt(assetNextStatus));
            moveCard(assetCard, assetNextStatus, false);
        });

        // Quick dispatch panel: collapsible, floats over the page so the board stays visible
        $("#quickDispatchToggle").on("click", function () {
            $("#quickDispatchPanel").toggleClass("open");
            if ($("#quickDispatchPanel").hasClass("open")) $("#assetTagQuickDispatch").focus();
        });
        try {
            const storedStatus = localStorage.getItem("quickDispatchStatus-{{ project.projects_id }}");
            if (storedStatus && $("#assetStatusSelectorQuickDispatch option[value='" + storedStatus + "']").length) $("#assetStatusSelectorQuickDispatch").val(storedStatus);
        } catch (e) {}
        $("#assetStatusSelectorQuickDispatch").on("change", function () {
            try { localStorage.setItem("quickDispatchStatus-{{ project.projects_id }}", $(this).val()); } catch (e) {}
        });

        /**
         * The scanned asset isn't in the project but an asset of the same type is, in a lower status: offer to swap them
         */
        function showSwapOffer(swap, targetStatus) {
            const statusName = $("#assetStatusSelectorQuickDispatch option:selected").text();
            dismissPendingSwapOffer();
            const offer = $("<div>").addClass("alert alert-info p-1 mb-1 swapOfferPending").data("tag", swap.assets_tag);
            offer.append($("<div>").text("Swap " + swap.assets_tag + " with:"));
            swap.candidates.forEach(function (candidate) {
                $("<button type='button'>").addClass("btn btn-sm btn-outline-primary mt-1 mr-1")
                    .text(candidate.assets_tag)
                    .on("click", function () {
                        offer.find("button").prop("disabled", true);
                        $.ajax({
                            url: "{{ CONFIG.ROOTURL }}/api/projects/assets/swap.php",
                            type: "POST",
                            data: {"assetsAssignments_id": candidate.assetsAssignments_id, "assets_id": swap.assets_id, "assetsAssignmentsStatus_id": targetStatus},
                            cache: false,
                            success: function (result) {
                                if (result.result === true) {
                                    const assetCard = $(".assetDispatchAssetList-card[data-assignment=" + candidate.assetsAssignments_id + "]");
                                    const link = assetCard.find("a").first();
                                    link.text(swap.assets_tag).attr("href", link.attr("href").replace(/asset=\d+/, "asset=" + swap.assets_id));
                                    assetCard.attr("data-asset", swap.assets_id);
                                    moveCard(assetCard, targetStatus, true);
                                    offer.removeClass("alert-info swapOfferPending").addClass("alert-success").text(candidate.assets_tag + " swapped for " + swap.assets_tag + " → " + statusName);
                                } else {
                                    offer.find("button").prop("disabled", false);
                                    Toast.fire({type: 'error', title: swap.assets_tag + ": swap failed - the asset may be unavailable for these dates"});
                                }
                            },
                            error: function () {
                                offer.find("button").prop("disabled", false);
                                Toast.fire({type: 'error', title: 'Connection error'});
                            }
                        });
                    }).appendTo(offer);
            });
            $("<button type='button'>").addClass("btn btn-sm btn-outline-secondary mt-1")
                .text("None")
                .on("click", dismissPendingSwapOffer)
                .appendTo(offer);
            $("#assetTagResultQuickDispatch").prepend(offer);
        }

        // An unanswered swap offer means the asset was not found
        function dismissPendingSwapOffer() {
            $(".swapOfferPending").each(function () {
                $(this).removeClass("alert-info swapOfferPending").addClass("alert-danger").text($(this).data("tag") + ": Asset not found");
            });
        }

        function doQuickDispatch() {
            const assetTag = $("#assetTagQuickDispatch").val();
            const assetStatus = $("#assetStatusSelectorQuickDispatch").val();
            if (assetTag.length < 1) return;
            dismissPendingSwapOffer();
            // Not using ajaxcall so we can have our own error handling for the alert boxes
            $.ajax({
                url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setStatusByTag.php",
                type: "POST",
                data: {
                    text: assetTag,
                    assetsAssignments_status: assetStatus,
                    projects_id: {{ project.projects_id }},
                },
                cache: false,
                success: function(result, status, data) {
                    if (result.result === true) {
                        const assetCard = $(".assetDispatchAssetList-card[data-asset=" + result.response.assets_id + "]");
                        moveCard(assetCard, assetStatus, true);
                        const statusName = $("#assetStatusSelectorQuickDispatch option:selected").text();
                        const unchanged = result.response.unchanged === true;
                        const resultDiv = $("<div>").addClass("alert p-1 mb-1").addClass(unchanged ? "alert-warning" : "alert-success")
                            .css(unchanged ? {"background-color": "#ffd8a8", "border-color": "#fd7e14", "color": "#7a3d00"} : {})
                            .text(unchanged ? assetTag + " is already " + statusName : assetTag + " → " + statusName);
                        $("#assetTagResultQuickDispatch").prepend(resultDiv);
                    } else if (result.error && result.error.code === "NOTINPROJECT") {
                        showSwapOffer(result.error.swap, assetStatus);
                    } else {
                        Toast.fire({
                            type: 'error',
                            title: assetTag + ": " + result.error.message
                        });
                        const resultDiv = $("<div>").addClass("alert alert-danger p-1 mb-1").text(assetTag + ": " + result.error.message);
                        $("#assetTagResultQuickDispatch").prepend(resultDiv);
                    }
                    $("#assetTagQuickDispatch").val("");
                    $("#assetTagQuickDispatch").focus();
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.log(jqXHR, textStatus, errorThrown);
                    console.log("Connection Error");
                    bootbox.alert('Sorry we couldn\'t connect to the internet - please check your connection', function () {
                        location.reload();
                    });
                }
            });
        }
        $("#assetTagQuickDispatch").on("keydown", function(e) {
            if (e.key !== "Enter") {
                return;
            }
            e.preventDefault();
            doQuickDispatch();
        });
        $("#goQuickDispatch").on("click", doQuickDispatch);
        {% endif %}

        $("#assetBoardEntityFilter").on("change", function () {
            const entity = $(this).val();
            $(".assetDispatchAssetList-card").each(function () {
                $(this).toggle(entity === "" || String($(this).data("entity")) === entity);
            });
        });
    });
</script>
