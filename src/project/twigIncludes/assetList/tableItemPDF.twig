{# ── Coeff (project-level, same for all rows) ─────────────────────────── #}
{% if FINANCIALS.priceMaths['days'] > 0 %}
    {% set coeffVal = FINANCIALS.priceMaths['days'] %}
    {% set coeffSuffix = 'd' %}
{% else %}
    {% set coeffVal = FINANCIALS.priceMaths['weeks'] %}
    {% set coeffSuffix = 'w' %}
{% endif %}
{% set coeffFmt = coeffVal|number_format(2, '.', '') %}
{% if coeffFmt ends with '.00' %}
    {% set coeffDisplay = coeffVal|number_format(0, '.', '') ~ coeffSuffix %}
{% elseif coeffFmt ends with '0' %}
    {% set coeffDisplay = coeffVal|number_format(1, '.', '') ~ coeffSuffix %}
{% else %}
    {% set coeffDisplay = coeffFmt ~ coeffSuffix %}
{% endif %}

{# ── Type summary row (multiple assets of same type) ─────────────────── #}
{% if type['assets']|length > 1 %}
    {% set firstAsset = type['assets'][0] %}
    {% if FINANCIALS.priceMaths['days'] > 0 %}
        {% set summaryRate = firstAsset.assets_dayRate is not null ? firstAsset.assets_dayRate : firstAsset.assetTypes_dayRate %}
    {% else %}
        {% set summaryRate = firstAsset.assets_weekRate is not null ? firstAsset.assets_weekRate : firstAsset.assetTypes_weekRate %}
    {% endif %}
[
    {% if GET['checkboxes'] %}'[  ]',{% endif %}
    '',
    {
        text: "{{ type['assets']|length }}x {{ firstAsset.manufacturers_id != 1 ? firstAsset.manufacturers_name|escape("js") ~ " - " : "" }}{{ firstAsset.assetTypes_name|escape("js") }}",
        style: { bold: true }
    },
    {% if GET['masses'] %}
        { text: '{{ type['totals']['mass'] > 0 ? type['totals']['mass']|number_format(2, ".", "")|escape("js") : "" }}', style: { alignment: 'right' } },
    {% endif %}
    {% if project.projectsTypes_config_finance == 1 %}
        {% if firstAsset.assetsAssignments_customPrice %}
            { text: '' }, { text: '' }, { text: '' }, { text: '' },
            { text: "{{ (type['totals']['discountPrice'].amount / 100)|number_format(2, '.', '')|escape("js") }}", style: { alignment: 'right' } },
        {% else %}
            { text: "{{ (summaryRate / 100)|number_format(2, '.', '')|escape("js") }}", style: { alignment: 'right' } },
            { text: "{{ coeffDisplay|escape("js") }}", style: { alignment: 'right' } },
            { text: "{{ (type['totals']['price'].amount / 100)|number_format(2, '.', '')|escape("js") }}", style: { alignment: 'right' } },
            { text: '' },
            { text: "{{ (type['totals']['discountPrice'].amount / 100)|number_format(2, '.', '')|escape("js") }}", style: { alignment: 'right' } },
        {% endif %}
    {% endif %}
],
{% endif %}

{# ── Individual asset rows ────────────────────────────────────────────── #}
{% for assetAssignment in type['assets'] %}
    {% if type['assets']|length == 1 or GET['showAll'] %}

        {% set isLinked = assetAssignment.assetsAssignments_linkedTo %}

        {# Effective rate (only needed for non-linked items) #}
        {% if not isLinked %}
            {% if FINANCIALS.priceMaths['days'] > 0 %}
                {% set effRate = assetAssignment.assets_dayRate is not null ? assetAssignment.assets_dayRate : assetAssignment.assetTypes_dayRate %}
            {% else %}
                {% set effRate = assetAssignment.assets_weekRate is not null ? assetAssignment.assets_weekRate : assetAssignment.assetTypes_weekRate %}
            {% endif %}

            {# Discount display (no leading zeros, strip trailing zeros) #}
            {% set disc = assetAssignment.assetsAssignments_discount %}
            {% if disc != 0 %}
                {% set discFmt = disc|number_format(2, '.', '') %}
                {% if discFmt ends with '.00' %}
                    {% set discDisplay = disc|number_format(0, '.', '') ~ '%' %}
                {% elseif discFmt ends with '0' %}
                    {% set discDisplay = disc|number_format(1, '.', '') ~ '%' %}
                {% else %}
                    {% set discDisplay = discFmt ~ '%' %}
                {% endif %}
            {% else %}
                {% set discDisplay = '' %}
            {% endif %}
        {% endif %}

[
    {% if GET['checkboxes'] %}'[  ]',{% endif %}
    '{{ assetAssignment.assets_tag|aTag|escape("js") }}',
    {% if isLinked %}
        { text: "[L]{% if assetAssignment.manufacturers_id != 1 %} {{ assetAssignment.manufacturers_name|escape("js") }} -{% endif %} {{ assetAssignment.assetTypes_name|escape("js") }}{% if GET['flagsBlocks'] %}{% for flag in assetAssignment.flagsblocks.FLAG %} [F]{% endfor %}{% for flag in assetAssignment.flagsblocks.BLOCK %} [B]{% endfor %}{% endif %}", color: '#595959' },
    {% else %}
        {
            stack: [
                { text: "{% if type['assets']|length == 1 %}{{ assetAssignment.manufacturers_id != 1 ? assetAssignment.manufacturers_name|escape("js") ~ " - " : "" }}{{ assetAssignment.assetTypes_name|escape("js") }}{% endif %}{% if GET['flagsBlocks'] %}{% for flag in assetAssignment.flagsblocks.FLAG %} [F]{% endfor %}{% for flag in assetAssignment.flagsblocks.BLOCK %} [B]{% endfor %}{% endif %}" }{% if assetAssignment.assetsAssignments_comment %},
                { text: "{{ assetAssignment.assetsAssignments_comment|escape("js") }}", color: '#595959', margin: [0, 2, 0, 0] }{% endif %}

            ]
        },
    {% endif %}
    {% if GET['masses'] %}
        { text: '{{ assetAssignment.assets_mass is not null ? assetAssignment.assets_mass|number_format(2, ".", "") : (assetAssignment.assetTypes_mass is not null and assetAssignment.assetTypes_mass != 0 ? assetAssignment.assetTypes_mass|number_format(2, ".", "") : "") }}', style: { alignment: 'right' } },
    {% endif %}
    {% if project.projectsTypes_config_finance == 1 %}
        {% if isLinked %}
            { text: '', colSpan: 5 }, {}, {}, {}, {},
        {% elseif assetAssignment.assetsAssignments_customPrice %}
            { text: '' }, { text: '' }, { text: '' }, { text: '' },
            { text: "{{ (assetAssignment.price.amount / 100)|number_format(2, '.', '')|escape("js") }}", style: { alignment: 'right' } },
        {% else %}
            { text: "{{ (effRate / 100)|number_format(2, '.', '')|escape("js") }}", style: { alignment: 'right' } },
            { text: "{{ coeffDisplay|escape("js") }}", style: { alignment: 'right' } },
            { text: "{{ (assetAssignment.price.amount / 100)|number_format(2, '.', '')|escape("js") }}", style: { alignment: 'right' } },
            { text: "{{ discDisplay|escape("js") }}", style: { alignment: 'right' } },
            { text: "{{ (assetAssignment.discountPrice.amount / 100)|number_format(2, '.', '')|escape("js") }}", style: { alignment: 'right' } },
        {% endif %}
    {% endif %}
],
        {# Render cross-type linked children immediately after this parent asset #}
        {% if linkedMap is defined and linkedMap['k' ~ assetAssignment.assetsAssignments_id] is defined %}
            {% for child in linkedMap['k' ~ assetAssignment.assetsAssignments_id] %}
[
    {% if GET['checkboxes'] %}'[  ]',{% endif %}
    '{{ child.assets_tag|aTag|escape("js") }}',
    { text: "[L]{% if child.manufacturers_id != 1 %} {{ child.manufacturers_name|escape("js") }} -{% endif %} {{ child.assetTypes_name|escape("js") }}{% if GET['flagsBlocks'] %}{% for flag in child.flagsblocks.FLAG %} [F]{% endfor %}{% for flag in child.flagsblocks.BLOCK %} [B]{% endfor %}{% endif %}", color: '#595959' },
    {% if GET['masses'] %}
        { text: '{{ child.assets_mass is not null ? child.assets_mass|number_format(2, ".", "") : (child.assetTypes_mass is not null and child.assetTypes_mass != 0 ? child.assetTypes_mass|number_format(2, ".", "") : "") }}', style: { alignment: 'right' } },
    {% endif %}
    {% if project.projectsTypes_config_finance == 1 %}
        { text: '', colSpan: 5 }, {}, {}, {}, {},
    {% endif %}
],
            {% endfor %}
        {% endif %}
    {% endif %}
{% endfor %}
